{
  "name": "guitar-tabs",
  "productName": "GuitarTabs",
  "version": "1.0.0",
  "description": "Editeur de grilles d'accords de guitare (diagrammes de manche)",
  "type": "module",
  "main": "src/main/main.cjs",
  "author": "Logan Toullec",
  "license": "MIT",
  "scripts": {
    "start": "node tools/run-electron.cjs .",
    "test": "node --test",
    "icons": "node tools/run-electron.cjs tools/make-icons.cjs",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac zip",
    "dist": "electron-builder --win portable --mac zip"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "fr.perso.guitartabs",
    "productName": "GuitarTabs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "GuitarTabs-${version}-portable.exe"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "GuitarTabs-${version}-${arch}-portable.${ext}"
    }
  },
  "allowScripts": {
    "electron@43.3.0": true
  }
}
